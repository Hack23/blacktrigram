{
  "$schema": "https://typedoc.org/schema.json",
  "entryPoints": ["./src/index.ts"],
  "entryPointStrategy": "expand",
  "out": "docs/api",
  "name": "Black Trigram (흑괘) - Korean Martial Arts Combat Simulator API",
  "readme": "README.md",
  "theme": "default",
  "plugin": ["typedoc-plugin-mermaid"],
  "exclude": [
    "**/*.test.ts",
    "**/*.test.tsx",
    "**/*.spec.ts",
    "**/*.spec.tsx",
    "**/node_modules/**",
    "**/dist/**",
    "**/build/**",
    "**/coverage/**",
    "**/.git/**",
    "src/vite-env.d.ts",
    "src/test-types.ts",
    "src/test/**",
    "**/*.ipynb",
    "**/*.css"
  ],
  "excludeExternals": false,
  "excludePrivate": false,
  "excludeProtected": false,
  "excludeNotDocumented": false,
  "hideGenerator": false,
  "includeVersion": true,
  "categorizeByGroup": true,
  "defaultCategory": "General",
  "categoryOrder": [
    "Core",
    "Game Systems",
    "Combat System",
    "AI System",
    "Animation System",
    "Physics System",
    "Trigram System",
    "Vital Point System",
    "Body Part System",
    "Audio System",
    "Player & Archetypes",
    "UI Components",
    "Screen Components",
    "Shared Components",
    "Three.js Components",
    "Game Components",
    "Hooks",
    "Utilities",
    "Performance",
    "Type Definitions",
    "Enumerations",
    "Constants",
    "General",
    "*"
  ],
  "sort": ["kind", "instance-first", "alphabetical"],
  "tsconfig": "tsconfig.json",
  "lang": "en",
  "githubPages": true,
  "sourceLinkTemplate": "https://github.com/Hack23/blacktrigram/blob/{gitRevision}/{path}#L{line}",
  "disableSources": false,
  "gitRevision": "main",
  "gitRemote": "origin",
  "navigationLinks": {
    "GitHub": "https://github.com/Hack23/blacktrigram",
    "README": "https://github.com/Hack23/blacktrigram/blob/main/README.md",
    "Game Design": "https://github.com/Hack23/blacktrigram/blob/main/game-design.md",
    "Architecture": "https://github.com/Hack23/blacktrigram/blob/main/ARCHITECTURE.md",
    "Combat System": "https://github.com/Hack23/blacktrigram/blob/main/COMBAT_ARCHITECTURE.md"
  },
  "sidebarLinks": {
    "Game Documentation": "https://github.com/Hack23/blacktrigram/tree/main/docs",
    "Korean Martial Arts": "https://github.com/Hack23/blacktrigram/blob/main/mindmap.md"
  },
  "searchInComments": true,
  "logLevel": "Info",
  "treatWarningsAsErrors": false,
  "pretty": true,
  "groupOrder": [
    "Classes",
    "Interfaces",
    "Type Aliases",
    "Enumerations",
    "Functions",
    "Variables",
    "Namespaces",
    "*"
  ],
  "kindSortOrder": [
    "Module",
    "Namespace",
    "Class",
    "Interface",
    "TypeAlias",
    "Enum",
    "Function",
    "Variable",
    "Property",
    "Method",
    "Constructor",
    "Parameter",
    "TypeParameter",
    "Accessor",
    "GetSignature",
    "SetSignature",
    "IndexSignature",
    "CallSignature",
    "ConstructorSignature"
  ],
  "validation": {
    "notExported": true,
    "invalidLink": true,
    "notDocumented": true
  },
  "requiredToBeDocumented": [
    "Module",
    "Namespace",
    "Class",
    "Interface",
    "Property",
    "Method",
    "Function",
    "TypeAlias",
    "Variable",
    "Enum",
    "EnumMember"
  ],
  "visibilityFilters": {
    "protected": true,
    "private": true,
    "inherited": true,
    "external": true
  },
  "commentStyle": "jsdoc",
  "useTsLinkResolution": true,
  "preserveLinkText": false,
  "treatValidationWarningsAsErrors": false,
  "cleanOutputDir": true,
  "titleLink": "/",
  "excludeTags": ["@internal", "@hidden", "@ignore"],
  "externalSymbolLinkMappings": {
    "three": {
      "Mesh": "https://threejs.org/docs/#api/en/objects/Mesh",
      "Group": "https://threejs.org/docs/#api/en/objects/Group",
      "Scene": "https://threejs.org/docs/#api/en/scenes/Scene",
      "PerspectiveCamera": "https://threejs.org/docs/#api/en/cameras/PerspectiveCamera",
      "WebGLRenderer": "https://threejs.org/docs/#api/en/renderers/WebGLRenderer",
      "Vector3": "https://threejs.org/docs/#api/en/math/Vector3",
      "Color": "https://threejs.org/docs/#api/en/math/Color",
      "Material": "https://threejs.org/docs/#api/en/materials/Material",
      "Geometry": "https://threejs.org/docs/#api/en/core/BufferGeometry",
      "Light": "https://threejs.org/docs/#api/en/lights/Light"
    },
    "react": {
      "*": "https://react.dev/reference/react/"
    },
    "@react-three/fiber": {
      "*": "https://docs.pmnd.rs/react-three-fiber/"
    },
    "@react-three/drei": {
      "*": "https://github.com/pmndrs/drei#readme"
    }
  },
  "blockTags": [
    "@alpha",
    "@beta",
    "@category",
    "@constant",
    "@deprecated",
    "@enum",
    "@event",
    "@example",
    "@experimental",
    "@group",
    "@hidden",
    "@ignore",
    "@inheritDoc",
    "@internal",
    "@korean",
    "@label",
    "@link",
    "@module",
    "@namespace",
    "@override",
    "@packageDocumentation",
    "@param",
    "@private",
    "@privateRemarks",
    "@protected",
    "@public",
    "@readonly",
    "@remarks",
    "@returns",
    "@satisfies",
    "@sealed",
    "@security",
    "@see",
    "@since",
    "@static",
    "@template",
    "@throws",
    "@todo",
    "@trigram",
    "@typeParam",
    "@vitalpoint",
    "@virtual"
  ],
  "inlineTags": ["@link", "@linkcode", "@linkplain", "@inheritDoc"],
  "modifierTags": [
    "@public",
    "@private",
    "@protected",
    "@internal",
    "@readonly",
    "@override",
    "@virtual",
    "@sealed",
    "@abstract",
    "@static",
    "@experimental",
    "@beta",
    "@alpha",
    "@deprecated"
  ]
}

{
  "$schema": "https://typedoc.org/schema.json",
  "entryPoints": [
    "./src/index.ts",
    "./src/audio/index.ts",
    "./src/systems/index.ts",
    "./src/systems/ai/index.ts",
    "./src/systems/animation/index.ts",
    "./src/systems/audio/index.ts",
    "./src/systems/bodypart/index.ts",
    "./src/systems/breathing/index.ts",
    "./src/systems/combat/index.ts",
    "./src/systems/movement/index.ts",
    "./src/systems/physics/index.ts",
    "./src/systems/trigram/index.ts",
    "./src/systems/vitalpoint/index.ts",
    "./src/components/index.ts",
    "./src/components/screens/combat/index.ts",
    "./src/components/screens/training/index.ts",
    "./src/components/screens/endscreen/index.ts",
    "./src/components/shared/base/index.ts",
    "./src/components/shared/mobile/index.ts",
    "./src/components/shared/three/index.ts",
    "./src/components/effects/index.ts",
    "./src/components/ui/combat/index.ts",
    "./src/utils/index.ts",
    "./src/utils/performance/index.ts",
    "./src/types/index.ts",
    "./src/types/constants/index.ts"
  ],
  "entryPointStrategy": "resolve",
  "out": "docs/api",
  "name": "Black Trigram (흑괘) - Korean Martial Arts Combat Simulator API",
  "readme": "README.md",
  "theme": "default",
  "plugin": ["typedoc-plugin-mermaid"],
  "exclude": [
    "**/*.test.ts",
    "**/*.test.tsx",
    "**/*.spec.ts",
    "**/*.spec.tsx",
    "**/node_modules/**",
    "**/dist/**",
    "**/build/**",
    "**/coverage/**",
    "**/.git/**",
    "src/vite-env.d.ts",
    "src/test-types.ts",
    "src/test/**",
    "**/*.ipynb",
    "**/*.css"
  ],
  "excludeExternals": false,
  "excludePrivate": false,
  "excludeProtected": false,
  "excludeNotDocumented": false,
  "hideGenerator": false,
  "includeVersion": true,
  "categorizeByGroup": true,
  "defaultCategory": "General",
  "categoryOrder": [
    "Core",
    "Game Systems",
    "Combat System",
    "AI System",
    "Animation System",
    "Physics System",
    "Trigram System",
    "Vital Point System",
    "Body Part System",
    "Breathing System",
    "Movement System",
    "Audio System",
    "Player & Archetypes",
    "UI Components",
    "Screen Components",
    "Combat Screen",
    "Training Screen",
    "End Screen",
    "Shared Components",
    "Three.js Components",
    "Mobile Components",
    "Visual Effects",
    "Game Components",
    "Hooks",
    "Utilities",
    "Performance",
    "Type Definitions",
    "Design System",
    "Enumerations",
    "Constants",
    "Data",
    "General",
    "*"
  ],
  "sort": ["kind", "instance-first", "alphabetical"],
  "tsconfig": "tsconfig.json",
  "lang": "en",
  "githubPages": true,
  "sourceLinkTemplate": "https://github.com/Hack23/blacktrigram/blob/{gitRevision}/{path}#L{line}",
  "disableSources": false,
  "gitRevision": "main",
  "gitRemote": "origin",
  "navigationLinks": {
    "🏠 Live Game": "https://blacktrigram.com/",
    "📦 npm Package": "https://www.npmjs.com/package/blacktrigram",
    "📦 GitHub": "https://github.com/Hack23/blacktrigram",
    "🛡️ ISMS": "https://github.com/Hack23/ISMS-PUBLIC"
  },
  "sidebarLinks": {
    "🏛️ Architecture": "https://github.com/Hack23/blacktrigram/blob/main/ARCHITECTURE.md",
    "🔒 Security Architecture": "https://github.com/Hack23/blacktrigram/blob/main/SECURITY_ARCHITECTURE.md",
    "🛡️ Threat Model": "https://github.com/Hack23/blacktrigram/blob/main/THREAT_MODEL.md",
    "📊 Data Model": "https://github.com/Hack23/blacktrigram/blob/main/DATA_MODEL.md",
    "🔄 Flowchart": "https://github.com/Hack23/blacktrigram/blob/main/FLOWCHART.md",
    "📈 State Diagram": "https://github.com/Hack23/blacktrigram/blob/main/STATEDIAGRAM.md",
    "🧠 Mindmap": "https://github.com/Hack23/blacktrigram/blob/main/MINDMAP.md",
    "💼 SWOT Analysis": "https://github.com/Hack23/blacktrigram/blob/main/SWOT.md",
    "🚀 Future Architecture": "https://github.com/Hack23/blacktrigram/blob/main/FUTURE_ARCHITECTURE.md",
    "🔮 Future Security": "https://github.com/Hack23/blacktrigram/blob/main/FUTURE_SECURITY_ARCHITECTURE.md",
    "🎮 Combat Architecture": "https://github.com/Hack23/blacktrigram/blob/main/COMBAT_ARCHITECTURE.md",
    "📋 CRA Assessment": "https://github.com/Hack23/blacktrigram/blob/main/CRA-ASSESSMENT.md",
    "📚 ISMS Mapping": "https://github.com/Hack23/blacktrigram/blob/main/ISMS_REFERENCE_MAPPING.md",
    "📋 Secure Dev Policy": "https://github.com/Hack23/ISMS-PUBLIC/blob/main/Secure_Development_Policy.md",
    "📖 Open Source Policy": "https://github.com/Hack23/ISMS-PUBLIC/blob/main/Open_Source_Policy.md"
  },
  "searchInComments": true,
  "logLevel": "Info",
  "treatWarningsAsErrors": false,
  "pretty": true,
  "groupOrder": [
    "Classes",
    "Interfaces",
    "Type Aliases",
    "Enumerations",
    "Functions",
    "Variables",
    "Namespaces",
    "*"
  ],
  "kindSortOrder": [
    "Module",
    "Namespace",
    "Class",
    "Interface",
    "TypeAlias",
    "Enum",
    "Function",
    "Variable",
    "Property",
    "Method",
    "Constructor",
    "Parameter",
    "TypeParameter",
    "Accessor",
    "GetSignature",
    "SetSignature",
    "IndexSignature",
    "CallSignature",
    "ConstructorSignature"
  ],
  "validation": {
    "notExported": true,
    "invalidLink": true,
    "notDocumented": true
  },
  "requiredToBeDocumented": [
    "Module",
    "Namespace",
    "Class",
    "Interface",
    "Property",
    "Method",
    "Function",
    "TypeAlias",
    "Variable",
    "Enum",
    "EnumMember"
  ],
  "visibilityFilters": {
    "protected": true,
    "private": true,
    "inherited": true,
    "external": true
  },
  "commentStyle": "jsdoc",
  "useTsLinkResolution": true,
  "preserveLinkText": false,
  "treatValidationWarningsAsErrors": false,
  "cleanOutputDir": true,
  "titleLink": "/",
  "excludeTags": ["@internal", "@hidden", "@ignore"],

{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": [
    "./src/main.tsx",
    "./src/index.ts",
    "./scripts/capture-screenshots.ts",
    "./eslint.config.js"
  ],
  "project": ["**/*.{ts,tsx}"],
  "ignore": ["src/systems/animation/**/*.test.ts", "typedoc.json"],
  "ignoreBinaries": ["dot"],
  "ignoreUnresolved": [],
  "rules": {
    "duplicates": "warn"
  },
  "eslint": {
    "config": [".eslintrc.cjs"]
  },
  "cypress": {
    "entry": [
      "cypress.config.ts",
      "cypress/e2e/*.spec.ts",
      "cypress/support/*.ts"
    ]
  }
}

{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": [
    "./src/main.tsx",
    "./src/index.ts",
    "./scripts/capture-screenshots.ts",
    "./eslint.config.js",
    "./typedoc.json",
    "./vite.config.ts",
    "./vitest.config.ts",
    "./cypress.config.ts"
  ],
  "project": ["**/*.{ts,tsx}"],
  "ignore": [],
  "ignoreBinaries": ["dot"],
  "eslint": {
    "config": [".eslintrc.cjs"]
  },
  "cypress": {
    "entry": [
      "cypress.config.ts",
      "cypress/e2e/*.spec.ts",
      "cypress/support/*.ts"
    ]
  }
}
